--- /dev/null
+++ b/internal/winrt/ui/notifications/factories_windows_test.go
@@ -0,0 +1,68 @@
+package notifications
+
+import (
+	"errors"
+	"os"
+	"os/exec"
+	"runtime"
+	"testing"
+
+	"git.sr.ht/~jackmordaunt/go-toast/v2/internal/winrt/data/xml/dom"
+	"github.com/go-ole/go-ole"
+	"golang.org/x/sys/windows"
+)
+
+func TestToastFactories(t *testing.T) {
+	if mode := os.Getenv("MAGPIE_TEST_TOAST_FACTORY"); mode != "" {
+		runtime.LockOSThread()
+		defer runtime.UnlockOSThread()
+		// Match WebView2's STA; MTA can hide upstream's null receiver.
+		if err := ole.RoInitialize(0); err != nil {
+			var oleErr *ole.OleError
+			if !errors.As(err, &oleErr) || oleErr.Code() != 1 {
+				t.Fatal(err)
+			}
+		}
+		defer windows.NewLazySystemDLL("combase.dll").NewProc("RoUninitialize").Call()
+		switch mode {
+		case "manager":
+			manager, err := GetDefault()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if manager == nil {
+				t.Fatal("nil notification manager")
+			}
+			manager.Release()
+		case "notification":
+			doc, err := dom.NewXmlDocument()
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer doc.Release()
+			if err := doc.LoadXml(`<toast><visual><binding template="ToastGeneric"><text>test</text></binding></visual></toast>`); err != nil {
+				t.Fatal(err)
+			}
+			toast, err := CreateToastNotification(doc)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if toast == nil {
+				t.Fatal("nil toast notification")
+			}
+			toast.Release()
+		default:
+			t.Fatalf("unknown factory %q", mode)
+		}
+		return
+	}
+	for _, mode := range []string{"manager", "notification"} {
+		t.Run(mode, func(t *testing.T) {
+			cmd := exec.CommandContext(t.Context(), os.Args[0], "-test.run=^TestToastFactories$")
+			cmd.Env = append(os.Environ(), "MAGPIE_TEST_TOAST_FACTORY="+mode)
+			if out, err := cmd.CombinedOutput(); err != nil {
+				t.Fatalf("%s factory crashed or failed: %v\n%s", mode, err, out)
+			}
+		})
+	}
+}
