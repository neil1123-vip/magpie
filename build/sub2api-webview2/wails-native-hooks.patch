diff --git a/internal/webview2/pkg/edge/native_hooks.go b/internal/webview2/pkg/edge/native_hooks.go
new file mode 100644
--- /dev/null
+++ b/internal/webview2/pkg/edge/native_hooks.go
@@ -0,0 +1,181 @@
+//go:build windows
+
+package edge
+
+import (
+	"fmt"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// NativeHooks belongs to an isolated host, and denies every popup and permission.
+type NativeHooks struct {
+	CancelNavigation func(string) bool
+	PopupDenied      func(string)
+	BlockRequest     func(string, uint32, uint32) bool
+	PermissionDenied func(int)
+	UserAgent        string
+}
+
+// InstallNativeHooks must complete before any external page is navigated.
+func (e *Chromium) InstallNativeHooks(hooks NativeHooks) error {
+	if hooks.UserAgent != "" {
+		settings, err := e.GetSettings()
+		if err != nil {
+			return fmt.Errorf("WebView2 settings: %w", err)
+		}
+		if settings == nil {
+			return fmt.Errorf("WebView2 settings unavailable")
+		}
+		settings2 := settings.GetICoreWebView2Settings2()
+		settings.Release()
+		if settings2 == nil {
+			return fmt.Errorf("ICoreWebView2Settings2 is required")
+		}
+		err = settings2.PutUserAgent(hooks.UserAgent)
+		settings2.Vtbl.Release.Call(uintptr(unsafe.Pointer(settings2)))
+		if err != nil {
+			return fmt.Errorf("WebView2 user agent: %w", err)
+		}
+	}
+	iid, _ := windows.GUIDFromString("{DB75DFC7-A857-4632-A398-6969DDE26C0A}")
+	var extended *nativeCore22
+	hr, _, _ := e.webview.vtbl.QueryInterface.Call(
+		uintptr(unsafe.Pointer(e.webview)), uintptr(unsafe.Pointer(&iid)), uintptr(unsafe.Pointer(&extended)),
+	)
+	if hr != 0 || extended == nil {
+		return fmt.Errorf("ICoreWebView2_22 is required: HRESULT %#x", hr)
+	}
+	defer extended.vtbl.Release.Call(uintptr(unsafe.Pointer(extended)))
+	pattern, _ := windows.UTF16PtrFromString("*")
+	hr, _, _ = extended.vtbl.AddFilter.Call(uintptr(unsafe.Pointer(extended)),
+		uintptr(unsafe.Pointer(pattern)), 0, 0xffffffff)
+	if hr != 0 {
+		return fmt.Errorf("Worker-aware request filter: HRESULT %#x", hr)
+	}
+	e.nativeHooks = &hooks
+	e.SetGlobalPermission(CoreWebView2PermissionStateDeny)
+	e.popupRequested = &nativePopupHandler{vtbl: &nativePopupHandlerTable, chromium: e}
+	var token _EventRegistrationToken
+	hr, _, _ = e.webview.vtbl.AddNewWindowRequested.Call(
+		uintptr(unsafe.Pointer(e.webview)), uintptr(unsafe.Pointer(e.popupRequested)), uintptr(unsafe.Pointer(&token)),
+	)
+	if hr != 0 {
+		return fmt.Errorf("NewWindowRequested: HRESULT %#x", hr)
+	}
+	return nil
+}
+
+// COM extension interfaces retain every base slot. Versions 2..21 add 62 slots.
+type nativeCore22Table struct {
+	iCoreWebView2Vtbl
+	Versions2Through21 [62]ComProc
+	AddFilter          ComProc
+	RemoveFilter       ComProc
+}
+
+type nativeCore22 struct{ vtbl *nativeCore22Table }
+
+type nativeNavigationTable struct {
+	_IUnknownVtbl
+	GetURI, IsUserInitiated, IsRedirected, RequestHeaders, GetCancel, PutCancel, NavigationID ComProc
+}
+
+type nativeNavigationArgs struct{ vtbl *nativeNavigationTable }
+
+func nativeURI(this unsafe.Pointer, getter ComProc) (string, error) {
+	var value *uint16
+	hr, _, _ := getter.Call(uintptr(this), uintptr(unsafe.Pointer(&value)))
+	if hr != 0 {
+		return "", windows.Errno(hr)
+	}
+	if value == nil {
+		return "", fmt.Errorf("native URI has no value")
+	}
+	defer CoTaskMemFree(unsafe.Pointer(value))
+	return windows.UTF16PtrToString(value), nil
+}
+
+func (i *nativeNavigationArgs) uri() (string, error) {
+	return nativeURI(unsafe.Pointer(i), i.vtbl.GetURI)
+}
+
+func (i *nativeNavigationArgs) cancel() error {
+	hr, _, _ := i.vtbl.PutCancel.Call(uintptr(unsafe.Pointer(i)), 1)
+	if hr != 0 {
+		return windows.Errno(hr)
+	}
+	return nil
+}
+
+type nativePopupTable struct {
+	_IUnknownVtbl
+	GetURI, PutNewWindow, GetNewWindow, PutHandled ComProc
+}
+
+type nativePopupArgs struct{ vtbl *nativePopupTable }
+type nativePopupHandler struct {
+	vtbl     *nativePopupHandlerVtbl
+	chromium *Chromium
+}
+type nativePopupHandlerVtbl struct {
+	_IUnknownVtbl
+	Invoke ComProc
+}
+
+var nativePopupHandlerTable = nativePopupHandlerVtbl{
+	_IUnknownVtbl{
+		NewComProc(func(this *nativePopupHandler, refiid, object uintptr) uintptr {
+			return this.chromium.QueryInterface(refiid, object)
+		}),
+		NewComProc(func(this *nativePopupHandler) uintptr { return this.chromium.AddRef() }),
+		NewComProc(func(this *nativePopupHandler) uintptr { return this.chromium.Release() }),
+	},
+	NewComProc(func(this *nativePopupHandler, _ *ICoreWebView2, args *nativePopupArgs) uintptr {
+		// Handled is set even if the URI cannot be read.
+		hr, _, _ := args.vtbl.PutHandled.Call(uintptr(unsafe.Pointer(args)), 1)
+		if hr != 0 {
+			this.chromium.errorCallback(windows.Errno(hr))
+			return hr
+		}
+		uri, _ := nativeURI(unsafe.Pointer(args), args.vtbl.GetURI)
+		if hook := this.chromium.nativeHooks.PopupDenied; hook != nil {
+			hook(uri)
+		}
+		return 0
+	}),
+}
+
+type nativeResourceArgs2Table struct {
+	_ICoreWebView2WebResourceRequestedEventArgsVtbl
+	GetSourceKind ComProc
+}
+type nativeResourceArgs2 struct{ vtbl *nativeResourceArgs2Table }
+
+func (i *ICoreWebView2WebResourceRequestedEventArgs) requestSourceKind() (uint32, error) {
+	iid, _ := windows.GUIDFromString("{9C562C24-B219-4D7F-92F6-B187FBBADD56}")
+	var extended *nativeResourceArgs2
+	hr, _, _ := i.vtbl.QueryInterface.Call(
+		uintptr(unsafe.Pointer(i)), uintptr(unsafe.Pointer(&iid)), uintptr(unsafe.Pointer(&extended)),
+	)
+	if hr != 0 || extended == nil {
+		return 0, fmt.Errorf("request source kind unavailable: HRESULT %#x", hr)
+	}
+	defer extended.vtbl.Release.Call(uintptr(unsafe.Pointer(extended)))
+	var source uint32
+	hr, _, _ = extended.vtbl.GetSourceKind.Call(uintptr(unsafe.Pointer(extended)), uintptr(unsafe.Pointer(&source)))
+	if hr != 0 {
+		return 0, windows.Errno(hr)
+	}
+	return source, nil
+}
+
+func (i *ICoreWebView2WebResourceRequestedEventArgs) resourceContext() (uint32, error) {
+	var context uint32
+	hr, _, _ := i.vtbl.GetResourceContext.Call(uintptr(unsafe.Pointer(i)), uintptr(unsafe.Pointer(&context)))
+	if hr != 0 {
+		return 0, windows.Errno(hr)
+	}
+	return context, nil
+}
